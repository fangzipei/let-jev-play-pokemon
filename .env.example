# Decisions API 密钥；JEV_MOCK=1 时可不填。
OPENROUTER_API_KEY=
# 决策模型 id；Decisions API 仅接受 jev 系列模型。
JEV_MODEL=~typesafe/jev-latest
# sdk/fetch 走 Decisions API（仅 jev 系列模型）；chat 把决策组装为 Chat Completions
# 提示词（临时方案，仅 choice 题型），可让任意对话模型（如 google/gemini-3.8-flash）做决策。
JEV_TRANSPORT=sdk
# jev 的 20s 共享预算包含 SDK→fetch、响应读取及所有重试，不按尝试重置。
JEV_TIMEOUT_MS=20000
# L1 完整客观上下文；L2 加条件化战术注解（默认）；L3 先 advisor 实时分析再交 jev。
# 非法等级 warn 并回退 2。
JEV_CONTEXT_LEVEL=2
# 仅为可配置起点，不承诺实测延迟、质量或费用。
JEV_ADVISOR_MODEL=google/gemini-3.8-flash
# 留空或仅空白时复用 OPENROUTER_API_KEY；非 mock 仍须配置主 key。
JEV_ADVISOR_API_KEY=
# advisor 本地等待预算（毫秒），同时受决策剩余总预算限制。
JEV_ADVISOR_TIMEOUT_MS=10000
# advisor 单次输出上限（多数供应商计入推理 token）；不是 120 词的同义限制，须为正安全整数，非法值启动拒绝。
JEV_ADVISOR_MAX_TOKENS=2048
# 显式推理强度（low/medium/high）；留空或空白则不发送 reasoning，仅对确认支持的模型设置；非法值启动拒绝。
JEV_ADVISOR_REASONING=
# 总预算覆盖上下文准备、advisor + jev；各阶段同时受剩余总预算限制。
# 三个超时/预算须为 1 至 2147483647 的整数毫秒数，非法值启动拒绝。
# 本地超时/取消不保证远端停止处理或不计费；费用仅记录已知值，不估算。
JEV_DECISION_BUDGET_MS=35000
# mock 同时跳过 jev 和 advisor，但仍可能连接 Showdown 和拉取 dex。
JEV_MOCK=0
# jev 的最多重试次数，与首次尝试共享预算；advisor 不重试。
JEV_RETRY=1
# Pikalytics 先验：1 启用（play 启动预拉、对手假设注入）；0 完全关闭。
JEV_PIKA_ENABLED=1
# Pikalytics 使用率 cutoff；须为正安全整数，非法值启动拒绝。
JEV_PIKA_CUTOFF=1760
# Pikalytics 缓存目录（不入库，按 dataDate 失效）。
JEV_PIKA_DIR=.cache/pikalytics
# 跨局经验库目录（不入库）；npm run review 读写此处。
JEV_MEMORY_DIR=.cache/jev-memory
# 复盘模型 id；留空 = 纯规则提取（npm run review）。
JEV_REVIEW_MODEL=
# 留空或仅空白时复用 OPENROUTER_API_KEY。
JEV_REVIEW_API_KEY=
# 复盘单次输出上限（含推理 token）；留空或仅空白则不发送 max_tokens（不限制）；设置须为正安全整数，非法值启动拒绝。
JEV_REVIEW_MAX_TOKENS=
# Showdown WebSocket 服务器地址。
PS_SERVER=wss://sim3.psim.us/showdown/websocket
# 登录名；留空自动生成 JevBot#### 游客名。
PS_USERNAME=
# 登录密码；游客模式留空。
PS_PASSWORD=
# 匹配用 format id。
PS_FORMAT=gen9championsvgc2026regmc
# 队伍 paste 文件路径。
TEAM_FILE=team.txt
# ladder 随机匹配 / challenge 挑战指定用户 / accept 自动接受他人挑战。
START_MODE=ladder
# START_MODE=challenge 时必填（挑战对象用户名）。
CHALLENGE_USER=
# 打完 N 场后退出。
MAX_BATTLES=1
# 0 = /choose 不追加 |<rqid>；默认 1 时追加。
SEND_RQID=1
# 日志目录（对局日志文件写入此处）。
LOG_DIR=logs
# debug / info / warn。
LOG_LEVEL=info
