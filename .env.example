OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest
# sdk/fetch 走 Decisions API（仅 jev 系列模型）；chat 把决策组装为 Chat Completions
# 提示词（临时方案，仅 choice 题型），可让任意对话模型（如 google/gemini-3.8-flash）做决策。
JEV_TRANSPORT=sdk
# jev 的 20s 共享预算包含 SDK→fetch、响应读取及所有重试，不按尝试重置。
JEV_TIMEOUT_MS=20000
# L1 完整客观上下文；L2 加条件化战术注解（默认）；L3 先 advisor 实时分析再交 jev。
# 非法等级 warn 并回退 2。
JEV_CONTEXT_LEVEL=2
# 仅为可配置起点，不承诺实测延迟、质量或费用。
JEV_ADVISOR_MODEL=google/gemini-3.8-flash
# 留空或仅空白时复用 OPENROUTER_API_KEY；非 mock 仍须配置主 key。
JEV_ADVISOR_API_KEY=
JEV_ADVISOR_TIMEOUT_MS=10000
# advisor 单次输出上限（多数供应商计入推理 token）；不是 120 词的同义限制，须为正安全整数，非法值启动拒绝。
JEV_ADVISOR_MAX_TOKENS=2048
# 显式推理强度（low/medium/high）；留空或空白则不发送 reasoning，仅对确认支持的模型设置；非法值启动拒绝。
JEV_ADVISOR_REASONING=
# 总预算覆盖上下文准备、advisor + jev；各阶段同时受剩余总预算限制。
# 三个超时/预算须为 1 至 2147483647 的整数毫秒数，非法值启动拒绝。
# 本地超时/取消不保证远端停止处理或不计费；费用仅记录已知值，不估算。
JEV_DECISION_BUDGET_MS=35000
# mock 同时跳过 jev 和 advisor，但仍可能连接 Showdown 和拉取 dex。
JEV_MOCK=0
# jev 的最多重试次数，与首次尝试共享预算；advisor 不重试。
JEV_RETRY=1
PS_SERVER=wss://sim3.psim.us/showdown/websocket
PS_USERNAME=
PS_PASSWORD=
PS_FORMAT=gen9championsvgc2026regmc
TEAM_FILE=team.txt
START_MODE=ladder
CHALLENGE_USER=
MAX_BATTLES=1
SEND_RQID=1
LOG_DIR=logs
LOG_LEVEL=info
